# Default: offline scripted sales scenarios, no model or credentials needed.
LLM_PROVIDER=demo
# For any compatible chat-completions endpoint:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=your-served-model-name
# LLM_API_KEY=your-key
LLM_API_KEY_ENV=LLM_API_KEY
MEMORY_PROVIDER=in-memory
MAX_ITERATIONS=12
LISTEN_ADDR=127.0.0.1:8080
# Without this, the server launches a private HTTP mock backend automatically.
# MOCK_BACKEND_URL=http://127.0.0.1:8081
# AGENTS_DIR=agents
# MOCK_DATA_DIR=mock
# WEB_DIR=web/dist
# Agent-specific HTTP integrations (overrides the shared mock endpoint):
# TELECOM_BACKEND_URL=http://127.0.0.1:8081
# HOSPITAL_BACKEND_URL=http://127.0.0.1:8081
