{
  "services": {
    "breeze": {
      "image": "ghcr.io/0xshug0/audio.cpp@sha256:3de68e87945ecddb6f835c72b958b2527655833f0540cd8b3fa0a1c5b22c9202",
      "container_name": "enterprise-speech-breeze",
      "command": [
        "server",
        "--config",
        "/config/server.json",
        "--no-ui"
      ],
      "restart": "unless-stopped",
      "gpus": "all",
      "ports": [
        "192.168.10.246:8092:8080"
      ],
      "volumes": [
        "/home/piwi/enterprise-speech/models:/models:ro",
        "./breeze.json:/config/server.json:ro"
      ],
      "mem_limit": "16g",
      "cpus": 6,
      "shm_size": "1g",
      "read_only": true,
      "tmpfs": [
        "/tmp:size=1073741824,mode=1777"
      ],
      "environment": {
        "CUDA_CACHE_PATH": "/tmp/cuda-cache"
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "--fail",
          "--silent",
          "http://127.0.0.1:8080/health"
        ],
        "interval": "15s",
        "timeout": "5s",
        "start_period": "120s",
        "retries": 5
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "labels": {
        "app.kubernetes.io/managed-by": "kuvryn-sync",
        "enterprise-ai-demo.component": "breeze"
      }
    },
    "nemotron": {
      "image": "ghcr.io/0xshug0/audio.cpp@sha256:3de68e87945ecddb6f835c72b958b2527655833f0540cd8b3fa0a1c5b22c9202",
      "container_name": "enterprise-speech-nemotron",
      "command": [
        "server",
        "--config",
        "/config/server.json",
        "--no-ui"
      ],
      "restart": "unless-stopped",
      "gpus": "all",
      "ports": [
        "192.168.10.246:8093:8080"
      ],
      "volumes": [
        "/home/piwi/enterprise-speech/models:/models:ro",
        "./nemotron.json:/config/server.json:ro"
      ],
      "mem_limit": "8g",
      "cpus": 6,
      "shm_size": "1g",
      "read_only": true,
      "tmpfs": [
        "/tmp:size=1073741824,mode=1777"
      ],
      "environment": {
        "CUDA_CACHE_PATH": "/tmp/cuda-cache"
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "--fail",
          "--silent",
          "http://127.0.0.1:8080/health"
        ],
        "interval": "15s",
        "timeout": "5s",
        "start_period": "120s",
        "retries": 5
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "labels": {
        "app.kubernetes.io/managed-by": "kuvryn-sync",
        "enterprise-ai-demo.component": "nemotron"
      }
    }
  }
}
